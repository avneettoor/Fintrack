rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Reusable Hardened Global Helpers
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMonthKey(val) {
      return val is string && val.size() == 7 && val.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidCategory(val) {
      return val is string && val in [
        'food',
        'transport',
        'campus',
        'entertainment',
        'subscriptions',
        'shopping',
        'hostel',
        'other'
      ];
    }

    function isValidPaymentMethod(val) {
      return val is string && val in ['upi', 'cash', 'card'];
    }

    function isValidGoalCategory(val) {
      return val is string && val in ['travel', 'tech', 'academics', 'emergency', 'lifestyle'];
    }

    function isValidStatus(val) {
      return val is string && val in ['active', 'completed'];
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================

    function isValidUserProfile(data, userId) {
      return data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.campusName is string
        && data.campusName.size() >= 1
        && data.campusName.size() <= 100
        && data.monthlyAllowance is number
        && data.monthlyAllowance >= 0
        && data.monthlyAllowance <= 1000000
        && data.planTier is string
        && data.planTier in ['free', 'campus_plus_interest']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000
        && isValidCategory(data.category)
        && isValidPaymentMethod(data.paymentMethod)
        && data.note is string
        && data.note.size() >= 1
        && data.note.size() <= 140
        && isValidDateString(data.date)
        && isValidMonthKey(data.monthKey)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidMonthKey(data.monthKey)
        && isValidCategory(data.category)
        && data.limitAmount is number
        && data.limitAmount >= 0
        && data.limitAmount <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoal(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 60
        && data.targetAmount is number
        && data.targetAmount > 0
        && data.targetAmount <= 10000000
        && data.savedAmount is number
        && data.savedAmount >= 0
        && data.savedAmount <= 10000000
        && isValidDateString(data.targetDate)
        && isValidGoalCategory(data.category)
        && isValidStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChallenge(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.templateId is string
        && data.templateId.size() >= 1
        && data.templateId.size() <= 40
        && data.templateId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.targetDays is number
        && data.targetDays >= 1
        && data.targetDays <= 90
        && data.completedDays is list
        && data.completedDays.size() <= 90
        && (data.completedDays.size() == 0 || isValidDateString(data.completedDays[0]))
        && isValidStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collections & Subcollections
    // =========================================================================

    match /users/{userId} {
      // PII isolated: owner-only get, never listable
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'email', 'campusName', 'monthlyAllowance', 'planTier', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'campusName', 'monthlyAllowance', 'planTier', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'campusName', 'monthlyAllowance', 'photoURL', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['planTier', 'updatedAt'])
        );

      allow delete: if false;

      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(expenseId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(expenseId)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'amount', 'category', 'paymentMethod', 'note', 'date', 'monthKey', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'amount', 'category', 'paymentMethod', 'note', 'date', 'monthKey', 'createdAt', 'updatedAt'])
          && isValidExpense(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(expenseId)
          && isOwner(userId)
          && isValidExpense(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'category', 'paymentMethod', 'note', 'date', 'monthKey', 'updatedAt'])
          && parentUserExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(expenseId)
          && isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(budgetId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(budgetId)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'monthKey', 'category', 'limitAmount', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'monthKey', 'category', 'limitAmount', 'createdAt', 'updatedAt'])
          && isValidBudget(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(budgetId)
          && isOwner(userId)
          && isValidBudget(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().monthKey == existing().monthKey
          && incoming().category == existing().category
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['limitAmount', 'updatedAt'])
          && parentUserExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(budgetId)
          && isOwner(userId);
      }

      match /goals/{goalId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(goalId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(goalId)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'title', 'targetAmount', 'savedAmount', 'targetDate', 'category', 'status', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'title', 'targetAmount', 'savedAmount', 'targetDate', 'category', 'status', 'createdAt', 'updatedAt'])
          && isValidGoal(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(goalId)
          && isOwner(userId)
          && isValidGoal(incoming(), userId)
          && existing().status != 'completed'
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['savedAmount', 'status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'targetAmount', 'targetDate', 'category', 'updatedAt'])
          )
          && parentUserExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(goalId)
          && isOwner(userId);
      }

      match /challenges/{challengeId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(challengeId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(challengeId)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'templateId', 'title', 'targetDays', 'completedDays', 'status', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'templateId', 'title', 'targetDays', 'completedDays', 'status', 'createdAt', 'updatedAt'])
          && isValidChallenge(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(challengeId)
          && isOwner(userId)
          && isValidChallenge(incoming(), userId)
          && existing().status != 'completed'
          && incoming().userId == existing().userId
          && incoming().templateId == existing().templateId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['completedDays', 'status', 'updatedAt'])
          && parentUserExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(challengeId)
          && isOwner(userId);
      }
    }
  }
}
