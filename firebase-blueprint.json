{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student profile, monthly allowance, and campus settings for FinTrack Campus.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name from Google Sign-In or profile.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address.",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "Optional profile avatar URL.",
          "maxLength": 500
        },
        "campusName": {
          "type": "string",
          "description": "College or university name (e.g., DBS Global University, Dehradun).",
          "minLength": 1,
          "maxLength": 100
        },
        "monthlyAllowance": {
          "type": "number",
          "description": "Fixed monthly allowance or spending budget in INR."
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "campus_plus_interest"],
          "description": "Student plan status for MVP validation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "campusName",
        "monthlyAllowance",
        "planTier",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "A daily student expense transaction logged in FinTrack Campus.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number",
          "description": "Expense amount in INR (> 0 and <= 1000000)."
        },
        "category": {
          "type": "string",
          "enum": [
            "food",
            "transport",
            "campus",
            "entertainment",
            "subscriptions",
            "shopping",
            "hostel",
            "other"
          ],
          "description": "Student spending category."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["upi", "cash", "card"],
          "description": "Payment mode used."
        },
        "note": {
          "type": "string",
          "description": "Short merchant or purchase description.",
          "minLength": 1,
          "maxLength": 140
        },
        "date": {
          "type": "string",
          "description": "Purchase date in YYYY-MM-DD format.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "monthKey": {
          "type": "string",
          "description": "Month partition key in YYYY-MM format.",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "minLength": 7,
          "maxLength": 7
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "amount",
        "category",
        "paymentMethod",
        "note",
        "date",
        "monthKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "CategoryBudget": {
      "title": "CategoryBudget",
      "description": "Monthly category spending cap configured by the student.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "description": "Month key in YYYY-MM format.",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "minLength": 7,
          "maxLength": 7
        },
        "category": {
          "type": "string",
          "enum": [
            "food",
            "transport",
            "campus",
            "entertainment",
            "subscriptions",
            "shopping",
            "hostel",
            "other"
          ],
          "description": "Budget category."
        },
        "limitAmount": {
          "type": "number",
          "description": "Monthly spending cap in INR (>= 0 and <= 1000000)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "monthKey",
        "category",
        "limitAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Student savings target with progress tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Goal title (e.g., Weekend Rishikesh Trip).",
          "minLength": 1,
          "maxLength": 60
        },
        "targetAmount": {
          "type": "number",
          "description": "Target savings amount in INR."
        },
        "savedAmount": {
          "type": "number",
          "description": "Current saved amount in INR."
        },
        "targetDate": {
          "type": "string",
          "description": "Target date in YYYY-MM-DD format.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "category": {
          "type": "string",
          "enum": ["travel", "tech", "academics", "emergency", "lifestyle"],
          "description": "Goal type."
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"],
          "description": "Goal completion status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "title",
        "targetAmount",
        "savedAmount",
        "targetDate",
        "category",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "HabitChallenge": {
      "title": "HabitChallenge",
      "description": "Student money-management challenge with daily check-in dates.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "templateId": {
          "type": "string",
          "description": "Identifier for the challenge template.",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Challenge name.",
          "minLength": 1,
          "maxLength": 80
        },
        "targetDays": {
          "type": "number",
          "description": "Number of check-in days required to complete."
        },
        "completedDays": {
          "type": "array",
          "description": "List of YYYY-MM-DD dates checked in (max 90)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"],
          "description": "Challenge completion status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "templateId",
        "title",
        "targetDays",
        "completedDays",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-only student profile and monthly allowance settings."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": {
        "$ref": "#/entities/Expense"
      },
      "description": "Daily expense records owned by the student."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": {
        "$ref": "#/entities/CategoryBudget"
      },
      "description": "Monthly category budget limits owned by the student."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": {
        "$ref": "#/entities/SavingsGoal"
      },
      "description": "Personal savings goals owned by the student."
    },
    "/users/{userId}/challenges/{challengeId}": {
      "schema": {
        "$ref": "#/entities/HabitChallenge"
      },
      "description": "Active and completed student financial habit challenges."
    }
  }
}
